FROM node:22-alpine AS build
WORKDIR /src

COPY package*.json ./
RUN npm ci

COPY . .

# Production API URLs are same-origin relative paths (see environment.production.ts),
# so the image works behind any host routed by the DutchPal IngressRoute.
RUN npm run build:prod

FROM nginx:1.27-alpine
COPY --from=build /src/dist/dutch-pal-ui/browser /usr/share/nginx/html
RUN printf '%s\n' \
  'server {' \
  '  listen 80;' \
  '  server_name _;' \
  '  root /usr/share/nginx/html;' \
  '  index index.html;' \
  '  location / {' \
  '    try_files $uri $uri/ /index.html;' \
  '  }' \
  '}' > /etc/nginx/conf.d/default.conf
EXPOSE 80
