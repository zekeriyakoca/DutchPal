FROM node:22-alpine AS build
WORKDIR /src

COPY package*.json ./
RUN npm ci

COPY . .

ARG PUBLIC_ORIGIN=https://dutchpal.lontray.art
ENV PUBLIC_ORIGIN=$PUBLIC_ORIGIN

# Keep the UI repo unchanged for now. The deploy source of truth owns the
# production origin used by the image build.
RUN node -e "const fs=require('fs'); const p='src/environments/environment.production.ts'; let s=fs.readFileSync(p,'utf8'); s=s.replace(/https:\\/\\/nest\\.lontray\\.shop/g, process.env.PUBLIC_ORIGIN); fs.writeFileSync(p,s);"

RUN npm run build:prod

FROM nginx:1.27-alpine
COPY --from=build /src/dist/dutch-pal-ui/browser /usr/share/nginx/html
RUN printf '%s\n' \
  'server {' \
  '  listen 80;' \
  '  server_name _;' \
  '  root /usr/share/nginx/html;' \
  '  index index.html;' \
  '  location / {' \
  '    try_files $uri $uri/ /index.html;' \
  '  }' \
  '}' > /etc/nginx/conf.d/default.conf
EXPOSE 80
