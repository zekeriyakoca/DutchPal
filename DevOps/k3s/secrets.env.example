# Copy this file to DevOps/k3s/secrets.env and fill values locally.
# DevOps/k3s/secrets.env is ignored by git.

POSTGRES_USER=dutchpal
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dutchpal

OPENAI_API_KEY=
GROQ_API_KEY=
CO_API_KEY=
LOGFIRE_TOKEN=

# Default (shared) Notion: used by anonymous users and by users without their own Notion.
NOTION_SECRET=
NOTION_NOUN_DB_ID=
NOTION_VERB_DB_ID=

# Google sign-in (optional; see docs/01-production-deployment.md#google-sign-in).
GOOGLE_CLIENT_ID=
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=

# Text-to-speech (optional; see docs/01-production-deployment.md#text-to-speech). Azure Speech, F0 tier.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
